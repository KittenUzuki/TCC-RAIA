rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário: /users/{uid}
    // O usuário só acessa o próprio documento (uid == id do documento).
    match /users/{userId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;

      // Favoritos do usuário: /users/{uid}/favoritos/{receitaId}
      // Mesma regra do documento pai: só o dono do uid acessa.
      match /favoritos/{receitaId} {
        allow read, create, update, delete:
          if request.auth != null && request.auth.uid == userId;
      }
    }

    // Ingredientes: coleção de nível raiz. Cada documento carrega o campo `userId`.
    // (Estrutura usada de fato pelo app: collection('ingredientes').add({... userId ...}))
    match /ingredientes/{docId} {
      // Leitura/consulta: só documentos do próprio usuário.
      allow read:
        if request.auth != null && resource.data.userId == request.auth.uid;

      // Criação: o documento novo precisa pertencer ao usuário autenticado.
      allow create:
        if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Edição/remoção: só documentos do próprio usuário.
      allow update, delete:
        if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // OBS: a coleção `receitas` (sugestões vindas da API de IA) não é lida/
    // escrita pelo Firestore — ela vem direto do backend Flask via HTTP.
    // Só os favoritos (acima, dentro de users/{uid}/favoritos) usam o Firestore.
  }
}
